<ContentPage
    x:Class="ExpenseSync.App.Views.MainPage"
    xmlns:vm="clr-namespace:ExpenseSync.App.ViewModels"
    x:DataType="vm:MainViewModel"
    Title="Home">

    <VerticalStackLayout Padding="20" Spacing="14">

        <VerticalStackLayout Spacing="6">
            <Label
                AutomationId="AppTitleLabel"
                Text="ExpenseSync"
                FontFamily="OpenSansSemibold"
                FontSize="28"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                AutomationId="AppDescriptionLabel"
                Text="Record expenses on this device, even without a network connection."
                FontSize="14"
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>

        <Border
            Padding="16"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
            <Grid
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto"
                RowSpacing="6">
                <Label
                    Text="Local database"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    SemanticProperties.HeadingLevel="Level2" />
                <Label
                    Grid.Column="1"
                    AutomationId="DatabaseStatusLabel"
                    Text="{Binding DatabaseStatus}"
                    FontFamily="OpenSansSemibold"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    AutomationId="DatabasePathLabel"
                    Text="{Binding DatabasePath}"
                    FontSize="12"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                    LineBreakMode="CharacterWrap" />
            </Grid>
        </Border>

    </VerticalStackLayout>

</ContentPage>
